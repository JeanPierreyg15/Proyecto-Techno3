# --- NORMALIZACIÓN SEO ---
RewriteEngine On

# 1. Redirigir www a NO-www (Redirección 301 permanente)
RewriteCond %{HTTP_HOST} ^www\.tamimaquinarias\.com [NC]
RewriteRule ^(.*)$ https://tamimaquinarias.com/$1 [L,R=301]

# 2. Redirecciones 301 — Rutas legacy / productos antiguos
RewriteRule ^sobre-nosotros/?$ /nosotros/ [L,R=301]
RewriteRule ^productos/?$ /catalogo-maquinarias/ [L,R=301]
RewriteRule ^productos/(.+)/?$ /catalogo-maquinarias/$1/ [L,R=301]

# 2b. /catalogo-maquinarias/detalle fue reemplazada por /catalogo-maquinarias/<slug>
RewriteCond %{QUERY_STRING} (^|&)link=([^&]+)
RewriteRule ^catalogo-maquinarias/detalle/?$ /catalogo-maquinarias/%2/? [R=301,L]
RewriteRule ^catalogo-maquinarias/detalle/?$ /catalogo-maquinarias/ [R=301,L]

# 3. Forzar slash final (Trailing Slash) en todas las URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# --- Habilitar rewrite para Astro ---
RewriteBase /

# 3b. Fallback para blogs creados después del último build.
# El sitio es estático: si la carpeta de un blog todavía no existe, servimos
# la página de respaldo (carga el contenido por API) en lugar de un 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/[^/]+/?$ /detalle-blog/index.html [L]

# 4. ErrorDocument 404
ErrorDocument 404 /404.html