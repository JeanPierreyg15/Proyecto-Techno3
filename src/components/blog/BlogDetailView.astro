---
import Layout from "src/layouts/Layout.astro";
import { config } from "config";
import { showLoaderString, removeLoaderString } from "src/utils/loader";
import blogHeroImage from "@images/index/hero/impulso-negocios-tecnologia.webp";

interface Props {
  /** Slug del blog. Si no se envía, se deduce desde la URL (modo fallback). */
  link?: string;
}

const { link = "" } = Astro.props;

const getApiUrl = config.apiUrl ? String(config.apiUrl).replace(/\/+$/, "") : "";
const blogsUrl = config.endpoints.blogs;
const productsUrl = config.endpoints.productos.list;
const canonicalUrl = link
  ? `https://tamimaquinarias.com/blog/${link}/`
  : "https://tamimaquinarias.com/blog/";
---

<Layout
  title="Blog | TAMI Maquinarias"
  description="Consejos, guías y novedades sobre maquinaria, empaque e iluminación para tu negocio."
  canonicalUrl={canonicalUrl}
>
  <header
    id="blog-header"
    class="relative w-full h-[34vh] sm:h-[52vh] lg:h-[60vh] max-h-[620px] min-h-[260px] flex items-center justify-center overflow-hidden pt-16 sm:pt-20"
  >
    <img
      id="blog-img"
      src={blogHeroImage.src}
      width={blogHeroImage.width}
      height={blogHeroImage.height}
      alt="Fondo Hero"
      title="Fondo Hero"
      class="absolute inset-0 w-full h-full object-cover brightness-[0.45]"
    />

    <!-- Overlay -->
    <div
      class="z-10 relative w-full h-full flex flex-col items-center justify-center text-white px-3 sm:px-8 py-2 sm:py-8 text-center"
    >
      <div class="max-w-5xl mx-auto font-bold w-full">
        <h1
          id="blog-title"
          class="font-montserrat tracking-tight leading-snug drop-shadow-lg break-words"
          style="font-size: clamp(0.85rem, 3.5vw + 0.5rem, 3.75rem); line-height: 1.2;"
        >
        </h1>
      </div>
    </div>
  </header>

  <style>
    #blog-img {
      animation: panHorizontal 10s ease-in-out infinite alternate;
      transform-origin: center;
      will-change: transform;
    }

    @keyframes panHorizontal {
      0% {
        transform: scale(1.1) translateX(3%);
      }
      100% {
        transform: scale(1.1) translateX(-3%);
      }
    }
  </style>

  <main
    class="py-8 md:py-16 px-4 md:px-8 bg-gradient-to-b from-[#041019] to-[#003E56]"
  >
    <!-- CONTENIDO PRINCIPAL -->
    <div
      id="blog-content"
      class="mx-auto w-full max-w-5xl px-5 sm:px-8 md:px-12 py-8 md:py-12 bg-white rounded-2xl md:rounded-3xl shadow-xl md:shadow-2xl mb-8 md:mb-16 border border-white/30"
    >
      <div class="mb-8 md:mb-10">
        <div class="mb-6 md:mb-8">
          <h2
            id="blog-content-subtitle"
            class="text-teal-700 text-xl md:text-2xl font-bold text-center break-words"
          >
          </h2>
          <h2
            id="blog-content-subtitle2"
            class="mt-3 max-w-3xl mx-auto px-1 md:px-4 text-base md:text-lg font-medium text-gray-600 text-center break-words"
          >
          </h2>
        </div>

        <!-- Fecha -->
        <div class="flex justify-center mb-8 md:mb-10">
          <div
            id="blog-date"
            class="inline-flex items-center gap-2 px-4 md:px-5 py-1.5 md:py-2 bg-teal-50 text-teal-800 text-xs md:text-sm font-semibold rounded-full border border-teal-100 shadow-sm"
          >
            Fecha de publicación no disponible
          </div>
        </div>

        <!-- Contenido principal -->
        <div id="blog-sections" class="space-y-6 md:space-y-8">
          <!-- Secciones dinámicas -->
        </div>

        <!-- BOTÓN VER PRODUCTO -->
        <div class="flex justify-center mt-10">
          <a
            id="btn-ver-producto"
            href="#"
            class="hidden bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-lg shadow-lg transition-all duration-300 transform hover:scale-105"
          >
            Ver Producto
          </a>
        </div>
      </div>

      <!-- VIDEO -->
      <div
        id="blog-video-container"
        class="hidden mt-10 md:mt-12 pt-8 md:pt-10 border-t border-gray-100"
      >
        <div id="blog-video-section"></div>
      </div>
    </div>

    <!-- 🔒 SCRIPTS -->
    <script
      define:vars={{
        getApiUrl,
        blogsUrl,
        productsUrl,
        blogLink: link,
        showLoaderString,
        removeLoaderString,
      }}
    >
      function sanitizeHtml(html) {
        if (!html) return "";
        const allowedTags = new Set([
          "P", "STRONG", "EM", "U", "A", "UL", "OL", "LI", "BR", "SPAN", "DIV",
          "H2", "H3", "H4", "BLOCKQUOTE",
        ]);
        const allowedAttrs = { A: ["href", "target", "rel", "title"] };
        const doc = new DOMParser().parseFromString(html, "text/html");

        function walk(node) {
          [...node.children].forEach((child) => {
            if (!allowedTags.has(child.tagName)) {
              child.replaceWith(...child.childNodes);
              return;
            }
            const allowed = allowedAttrs[child.tagName] || [];
            [...child.attributes].forEach((attr) => {
              if (!allowed.includes(attr.name)) child.removeAttribute(attr.name);
            });
            if (child.tagName === "A") {
              const href = child.getAttribute("href") || "";
              if (href.trim().toLowerCase().startsWith("javascript:")) {
                child.removeAttribute("href");
              }
            }
            walk(child);
          });
        }
        walk(doc.body);
        return doc.body.innerHTML;
      }

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      eval(showLoaderString);
      eval(removeLoaderString);

      function getBlogImageUrl(imagePath) {
        if (!imagePath) return "";
        if (imagePath.startsWith("http") || imagePath.startsWith("//")) {
          return imagePath;
        }
        const normalizedBase = String(getApiUrl || "").replace(/\/$/, "");
        const normalizedPath = imagePath.startsWith("/")
          ? imagePath
          : `/${imagePath}`;
        return `${normalizedBase}${normalizedPath}`;
      }

      function getCurrentSlugFromPath() {
        const segments = window.location.pathname.split("/").filter(Boolean);
        const last = segments[segments.length - 1] || "";
        if (!last || last === "detalle-blog") return "";
        try {
          return decodeURIComponent(last);
        } catch (error) {
          return last;
        }
      }

      function removeLoaderSafe() {
        try {
          removeLoader();
        } catch (error) {}
        setTimeout(() => {
          const loader = document.getElementById("page-loader");
          if (loader) loader.remove();
        }, 100);
      }

      async function initBlogDetail() {
        showLoader();
        const safetyTimeout = setTimeout(removeLoaderSafe, 10000);
        let notFound = false;
        try {
          const linkBlog = String(blogLink || "").trim() || getCurrentSlugFromPath();
          if (!linkBlog) {
            const emptyHeader = document.getElementById("blog-header");
            if (emptyHeader) emptyHeader.style.display = "none";
            const emptyContent = document.getElementById("blog-content");
            if (emptyContent) {
              emptyContent.innerHTML = `
                <div class="text-center py-10 md:py-16">
                  <h1 class="text-2xl md:text-3xl font-bold text-teal-700 mb-4">Blog de TAMI Maquinarias</h1>
                  <p class="text-gray-600 mb-8 text-lg max-w-2xl mx-auto">Encuentra consejos, guías y novedades sobre maquinaria, empaque e iluminación para tu negocio.</p>
                  <a href="/blog/" class="inline-block bg-teal-700 text-white px-8 py-3 rounded-lg hover:bg-teal-800 font-bold shadow-lg transition-transform hover:scale-105">
                    Ver todos los artículos
                  </a>
                </div>
              `;
            }
            clearTimeout(safetyTimeout);
            removeLoaderSafe();
            return;
          }
          const encodedLink = encodeURIComponent(linkBlog);
          const fullUrl = `${getApiUrl}${blogsUrl.list}/link/${encodedLink}`;
          if (!fullUrl.startsWith("http"))
            throw new Error(`URL inválida: ${fullUrl}`);
          const response = await fetch(fullUrl);
          if (!response.ok) {
            // La API devuelve 500 cuando el blog no existe ("No query results
            // for model..."), así que revisamos el mensaje para distinguirlo
            // de un fallo real del servidor.
            let detail = "";
            try {
              const errorBody = await response.clone().json();
              detail = String(errorBody?.message || "");
            } catch (error) {}
            notFound =
              response.status === 404 ||
              /no query results|not found|no encontrado/i.test(detail);
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          const data = await response.json();
          if (!data || !data.data)
            throw new Error("No se encontraron datos del blog");
          const blog = data.data;

          function setDynamicSEO(blog) {
            document.title = blog.etiqueta?.meta_titulo || blog.titulo || "Blog TAMI";
            let metaDescription = document.querySelector(
              'meta[name="description"]',
            );
            if (!metaDescription) {
              metaDescription = document.createElement("meta");
              metaDescription.name = "description";
              document.head.appendChild(metaDescription);
            }
            metaDescription.content =
              blog.etiqueta?.meta_descripcion ||
              blog.subtitulo1 ||
              "Blog de Tami Maquinarias";
            let canonicalLink = document.querySelector('link[rel="canonical"]');
            if (canonicalLink) {
              canonicalLink.href = window.location.href;
            }
          }

          function generateBlogJsonLd(blog) {
            const images = [
              getBlogImageUrl(blog.miniatura),
              ...(blog.imagenes?.map((img) =>
                getBlogImageUrl(img.ruta_imagen),
              ) || []),
            ];
            const description =
              blog.subtitulo1 || blog.parrafos?.map((p) => p.parrafo).join(" ");
            return {
              "@context": "https://schema.org/",
              "@type": "Blog",
              "@id": "https://tamimaquinarias.com/blog/",
              mainEntityOfPage: "https://tamimaquinarias.com/blog/",
              name: blog.titulo,
              description: description,
              publisher: {
                "@type": "Organization",
                "@id": "https://tamimaquinarias.com",
                name: "Tami Maquinarias",
                logo: {
                  "@type": "ImageObject",
                  "@id":
                    "https://tamimaquinarias.com/_astro/logo-estatico-100x116.B0Pf3Br1.webp",
                  url: "https://tamimaquinarias.com/_astro/logo-estatico-100x116.B0Pf3Br1.webp",
                  width: "600",
                  height: "60",
                },
              },
              blogPost: [
                {
                  "@type": "BlogPosting",
                  "@id": `https://tamimaquinarias.com/blog/${linkBlog}`,
                  mainEntityOfPage: `https://tamimaquinarias.com/blog/${linkBlog}`,
                  headline: blog.nombre_producto,
                  name: blog.nombre_producto,
                  description: description,
                  datePublished: blog.created_at,
                  dateModified: blog.updated_at,
                  author: {
                    "@type": "Person",
                    url: "https://tamimaquinarias.com",
                    name: "Equipo Tami Maquinarias",
                  },
                  image: {
                    "@type": "ImageObject",
                    "@id": images[0],
                    url: images[0],
                    height: "800",
                    width: "1200",
                  },
                  url: `https://tamimaquinarias.com/blog/${linkBlog}`,
                  keywords: ["LED", "Marketing Visual"],
                },
              ],
            };
          }

          function insertJsonLdBlog(blog) {
            const jsonLd = generateBlogJsonLd(blog);
            const script = document.createElement("script");
            script.type = "application/ld+json";
            script.text = JSON.stringify(jsonLd, null, 2);
            document.head.appendChild(script);
          }

          setDynamicSEO(blog);
          insertJsonLdBlog(blog);

          const blogTitleElement = document.getElementById("blog-title");
          const blogImgElement = document.getElementById("blog-img");
          const blogDateElement = document.getElementById("blog-date");
          const blogContentSubtitleElement = document.getElementById(
            "blog-content-subtitle",
          );
          const blogContentSubtitle2Element = document.getElementById(
            "blog-content-subtitle2",
          );
          const blogSectionsElement = document.getElementById("blog-sections");
          const blogVideoSectionElement =
            document.getElementById("blog-video-section");
          const blogVideoContainerElement = document.getElementById(
            "blog-video-container",
          );

          const titulo = String(blog.titulo || "").toUpperCase();

          if (blogImgElement) {
            blogImgElement.src = getBlogImageUrl(
              blog.hero_image || blog.miniatura || "/images/fallback.webp",
            );
            blogImgElement.alt = blog.titulo || "Blog TAMI";
            blogImgElement.title = blog.titulo || "Blog TAMI";
          }

          if (blogTitleElement) blogTitleElement.textContent = titulo;
          if (blogContentSubtitleElement)
            blogContentSubtitleElement.textContent = String(
              blog.subtitulo1 || "",
            ).toUpperCase();
          if (blogContentSubtitle2Element)
            blogContentSubtitle2Element.textContent = blog.subtitulo2 || "";

          if (blogDateElement) {
            const dateStr = blog.created_at || blog.updated_at;
            if (dateStr) {
              // Parse manual para evitar desfases por zona horaria
              const parts = dateStr.split(/[- :T]/);
              const year = parts[0];
              const month = parts[1];
              const day = parts[2];
              blogDateElement.textContent = `Publicado el ${day}/${month}/${year}`;
            } else {
              blogDateElement.textContent = "Fecha de publicación no disponible";
            }
          }

          const btnVerProducto = document.getElementById("btn-ver-producto");

          if (btnVerProducto && blog.producto_id) {
            let slugProducto = "";

            // Intento 1: Objeto directo
            if (blog.producto && blog.producto.link) {
              slugProducto = blog.producto.link;
            }
            // Intento 2: Propiedad plana
            else if (blog.producto_link) {
              slugProducto = blog.producto_link;
            }
            // Intento 3: Fetch adicional al API de productos
            else {
              try {
                const prodRes = await fetch(
                  `${getApiUrl}${productsUrl}/${blog.producto_id}`,
                );
                if (prodRes.ok) {
                  const prodData = await prodRes.json();
                  const productoReal = prodData.data || prodData;
                  if (productoReal && productoReal.link) {
                    slugProducto = productoReal.link;
                  }
                }
              } catch (err) {
                console.error("Error buscando el producto relacionado:", err);
              }
            }

            if (slugProducto) {
              // El API puede devolver el link como slug o como URL completa.
              slugProducto = String(slugProducto)
                .split(/[?#]/)[0]
                .replace(/\/+$/, "")
                .split("/")
                .filter(Boolean)
                .pop() || "";
              btnVerProducto.href = `/catalogo-maquinarias/${slugProducto}`;
              btnVerProducto.innerText =
                blog.etiqueta?.popup_button_text?.trim() || "Ver Producto";
              if (blog.etiqueta?.popup_button_color) {
                btnVerProducto.style.setProperty(
                  "background-color",
                  blog.etiqueta.popup_button_color,
                  "important",
                );
              }
              if (blog.etiqueta?.popup_text_color) {
                btnVerProducto.style.setProperty(
                  "color",
                  blog.etiqueta.popup_text_color,
                  "important",
                );
              }
              btnVerProducto.classList.remove("hidden");
              btnVerProducto.classList.add("inline-block");
            }
          }

          if (blogSectionsElement) {
            const parrafos = Array.isArray(blog.parrafos) ? blog.parrafos : [];
            const imagenes = Array.isArray(blog.imagenes) ? blog.imagenes : [];
            const total = Math.max(parrafos.length, imagenes.length);

            blogSectionsElement.innerHTML = "";

            for (let index = 0; index < total; index++) {
              const rawText = parrafos[index]?.parrafo || "";
              const imagen = imagenes[index];
              const imageSrc = imagen?.ruta_imagen
                ? getBlogImageUrl(imagen.ruta_imagen)
                : "";
              const imageAlt = escapeHtml(
                imagen?.text_alt || blog.titulo || "Imagen del blog",
              );
              const reverse = index % 2 === 1;

              const plainText = String(rawText)
                .replace(/<[^>]*>/g, " ")
                .replace(/\s+/g, " ")
                .trim();
              // Un párrafo corto junto a una foto grande dejaba la columna de
              // texto casi vacía. En ese caso equilibramos alturas y centramos.
              const isShort = plainText.length > 0 && plainText.length < 220;

              const section = document.createElement("section");
              section.className = "blog-section";

              if (rawText && imageSrc) {
                section.innerHTML = `
                <div class="flex flex-col min-[930px]:flex-row ${reverse ? "min-[930px]:flex-row-reverse" : ""} items-stretch gap-5 md:gap-8 rounded-2xl border border-gray-100 bg-gray-50/70 p-4 md:p-6">
                  <div class="w-full min-[930px]:w-1/2 flex flex-col justify-center ${isShort ? "min-[930px]:py-3" : "min-[930px]:py-1"}">
                    <div class="blog-prose text-[15px] md:text-base leading-7 text-left break-words ${isShort ? "rounded-xl border border-teal-100 bg-white px-4 py-3 md:px-5 md:py-4 text-teal-900 md:text-lg" : "text-gray-700"}">
                      ${sanitizeHtml(rawText)}
                    </div>
                  </div>
                  <figure class="w-full min-[930px]:w-1/2 overflow-hidden rounded-xl bg-gray-100 ${isShort ? "min-[930px]:max-h-[260px]" : "min-[930px]:max-h-[380px]"}">
                    <img
                      src="${escapeHtml(imageSrc)}"
                      alt="${imageAlt}"
                      title="${imageAlt}"
                      loading="lazy"
                      decoding="async"
                      class="block w-full h-full min-h-[190px] max-h-[300px] min-[930px]:max-h-none object-cover transition-transform duration-500 ease-out hover:scale-[1.03]"
                    />
                  </figure>
                </div>
              `;
              } else if (rawText) {
                section.innerHTML = `
                <div class="mx-auto max-w-3xl rounded-2xl border border-gray-100 bg-gray-50/70 px-5 py-5 md:px-7 md:py-6">
                  <div class="blog-prose text-[15px] md:text-base leading-7 text-gray-700 break-words">
                    ${sanitizeHtml(rawText)}
                  </div>
                </div>
              `;
              } else if (imageSrc) {
                section.innerHTML = `
                <figure class="overflow-hidden rounded-2xl bg-gray-100">
                  <img
                    src="${escapeHtml(imageSrc)}"
                    alt="${imageAlt}"
                    title="${imageAlt}"
                    loading="lazy"
                    decoding="async"
                    class="block w-full max-h-[420px] object-cover"
                  />
                </figure>
              `;
              } else {
                continue;
              }

              blogSectionsElement.appendChild(section);
            }
          }

          if (blogVideoSectionElement && blog.video_id) {
            function getYoutubeVideoId(videoValue) {
              if (!videoValue || typeof videoValue !== "string") return "";
              const value = videoValue.trim();
              if (!value) return "";

              const directIdMatch = value.match(/^[a-zA-Z0-9_-]{11}$/);
              if (directIdMatch) return value;

              const urlMatch = value.match(
                /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/,
              );

              return urlMatch?.[1] || "";
            }

            const validVideoId = getYoutubeVideoId(blog.video_id);

            if (!validVideoId) {
              if (blogVideoContainerElement) {
                blogVideoContainerElement.classList.add("hidden");
              }
            } else {
              if (blogVideoContainerElement) {
                blogVideoContainerElement.classList.remove("hidden");
              }

              blogVideoSectionElement.innerHTML = `
            <section class="rounded-xl md:rounded-2xl shadow-sm py-4 md:py-5 px-4 md:px-8 bg-gray-50">
                <h2 class="text-lg md:text-xl lg:text-2xl text-teal-700 font-bold mb-4 md:mb-6 text-center md:text-left break-words">${escapeHtml(blog.video_titulo)}</h2>
                <div class="relative w-full h-48 md:h-64 lg:h-[30rem] rounded-lg overflow-hidden">
                    <iframe
                        width="100%"
                        height="100%"
                        src="https://www.youtube.com/embed/${validVideoId}"
                        title="YouTube video player"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                        class="rounded-lg w-full h-full"
                    ></iframe>
                </div>
            </section>
          `;
            }
          } else if (blogVideoContainerElement) {
            blogVideoContainerElement.classList.add("hidden");
          }

          clearTimeout(safetyTimeout);
          removeLoaderSafe();
        } catch (error) {
          const blogHeader = document.getElementById("blog-header");
          if (blogHeader) {
            blogHeader.style.display = "none";
          }

          const blogContent = document.getElementById("blog-content");
          if (blogContent) {
            blogContent.classList.add(
              "mt-24",
              "md:mt-32",
              "min-h-[50vh]",
              "flex",
              "flex-col",
              "items-center",
              "justify-center",
            );

            if (notFound) {
              // Un blog eliminado no debe indexarse como si existiera.
              let robots = document.querySelector('meta[name="robots"]');
              if (!robots) {
                robots = document.createElement("meta");
                robots.name = "robots";
                document.head.appendChild(robots);
              }
              robots.content = "noindex, follow";
              document.title = "Artículo no encontrado | TAMI";
            }

            blogContent.innerHTML = `
            <div class="text-center p-8 md:py-10">
              <h2 class="text-3xl font-bold ${notFound ? "text-teal-700" : "text-red-600"} mb-4">
                ${notFound ? "Artículo no encontrado" : "Error al cargar el blog"}
              </h2>
              <p class="text-gray-600 mb-8 text-lg max-w-2xl mx-auto">
                ${
                  notFound
                    ? "El artículo que buscas no existe o fue retirado. Puedes revisar los demás artículos de nuestro blog."
                    : "No se pudo cargar el contenido del blog o el enlace es incorrecto. Por favor, verifica la URL e intenta nuevamente."
                }
              </p>
              <a href="/blog/" class="inline-block bg-teal-700 text-white px-8 py-3 rounded-lg hover:bg-teal-800 font-bold shadow-lg transition-transform hover:scale-105">
                Ir al blog
              </a>
              ${
                notFound
                  ? ""
                  : '<button onclick="window.location.reload()" class="ml-3 bg-blue-500 text-white px-8 py-3 rounded-lg hover:bg-blue-600 font-bold shadow-lg transition-transform hover:scale-105">Reintentar</button>'
              }
            </div>
          `;
          }
          clearTimeout(safetyTimeout);
          removeLoaderSafe();
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBlogDetail, {
          once: true,
        });
      } else {
        initBlogDetail();
      }

      window.addEventListener("load", () => {
        setTimeout(() => {
          const loader = document.getElementById("page-loader");
          if (loader) loader.remove();
        }, 500);
      });
      window.addEventListener("error", (event) => {
        if (event.error?.message?.includes("classList")) removeLoaderSafe();
      });
    </script>
  </main>
</Layout>

<style is:global>
  #blog-sections .blog-prose > * + * {
    margin-top: 0.85rem;
  }

  #blog-sections .blog-prose p {
    margin: 0;
  }

  #blog-sections .blog-prose strong {
    color: #0f766e;
    font-weight: 700;
  }

  #blog-sections .blog-prose em {
    color: #134e4a;
  }

  #blog-sections .blog-prose a {
    color: #0f766e;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #blog-sections .blog-prose a:hover {
    color: #115e59;
  }

  #blog-sections .blog-prose ul,
  #blog-sections .blog-prose ol {
    padding-left: 1.35rem;
    margin-top: 0.65rem;
