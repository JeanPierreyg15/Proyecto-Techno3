---
import BlogDetailView from "src/components/blog/BlogDetailView.astro";
import { config } from "config";
import type Blog from "src/models/Blog";
import { fetchBuildJson } from "src/lib/api/buildFetch";
import { normalizeLink } from "src/utils/blogLink";

export async function getStaticPaths() {
  const data = await fetchBuildJson<Blog[] | { data?: Blog[] }>(
    config.endpoints.blogs.list,
  );

  if (!data) {
    console.warn(
      "No se pudo obtener la lista de blogs: se usarán solo las páginas de respaldo.",
    );
    return [];
  }

  const blogs: Blog[] = Array.isArray(data) ? data : (data.data ?? []);
  const slugs = new Set<string>();

  for (const blog of blogs) {
    const slug = normalizeLink(blog.link);
    if (slug) slugs.add(slug);
  }

  return [...slugs].map((link) => ({
    params: { link },
  }));
}

const { link } = Astro.params;
---

<BlogDetailView link={link} />
