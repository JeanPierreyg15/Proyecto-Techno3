---
import Layout from "src/layouts/Layout.astro";
import ProductPage from "src/components/products/ProductPage";
import type Producto from "src/models/Product";
import { config } from "../../../config";
import { fetchBuildJson } from "src/lib/api/buildFetch";
import { normalizeLink } from "src/utils/blogLink";

export async function getStaticPaths() {
  const data = await fetchBuildJson<Producto[] | { data?: Producto[] }>(
    config.endpoints.productos.list,
  );

  if (!data) {
    // Con reintentos en `fetchBuildJson`, llegar aquí significa que la API
    // sigue caída: es mejor fallar el build que desplegar el catálogo vacío.
    throw new Error("Error obteniendo productos: la API no respondió");
  }

  const products: Producto[] = Array.isArray(data) ? data : (data.data ?? []);

  return products
    .map((product) => ({ ...product, link: normalizeLink(product.link) }))
    .filter((product) => product.link)
    .map((product) => ({
      params: {
        link: product.link,
      },
      props: {
        producto: product,
      },
    }));
}

const { producto } = Astro.props;
---

<Layout
  title="Detalle de Producto - Tami Maquinarias"
  description="Cargando detalles de producto..."
  keywords=""
  canonicalUrl={`https://tamimaquinarias.com/catalogo-maquinarias/${producto.link}/`}
  >
  <ProductPage
    producto={producto}
    client:load
  />
</Layout>

<script is:inline>
  (function () {
    var canonicalLink = document.querySelector('link[rel="canonical"]');

    if (canonicalLink) {
      canonicalLink.href = window.location.href.split("#")[0];
    }
  })();
</script>